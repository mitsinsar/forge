+    def mv_pipeline(self):
+        """Local patch (AssetForge): the multi-view shape model (Hunyuan3D-2mv turbo), loaded on first
+        use. Its config names the 2.0 package (hy3dgen.shapegen); 2.1 has the same classes in
+        hy3dshape, so the old names are pointed at them."""
+        if getattr(self, "_mv_pipeline", None) is None:
+            import sys
+            import types
+            import hy3dshape
+            import hy3dshape.models
+            import hy3dshape.pipelines
+            import hy3dshape.preprocessors
+            import hy3dshape.schedulers
+            alias = types.ModuleType("hy3dgen")
+            alias.shapegen = hy3dshape
+            sys.modules.setdefault("hy3dgen", alias)
+            sys.modules.setdefault("hy3dgen.shapegen", hy3dshape)
+            for name in ("models", "pipelines", "preprocessors", "schedulers"):
+                sys.modules.setdefault(f"hy3dgen.shapegen.{name}", getattr(hy3dshape, name))
